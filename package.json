{
  "name": "deneyap-atolye",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-based 3D lab and course for Arduino-style programming on the Deneyap Kart 1A v2 (ESP32-S3)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "npm run build && electron .",
    "electron:pack": "npm run build && electron-builder --win nsis portable --x64",
    "electron:dir": "npm run build && electron-builder --win --dir --x64",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:apk": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "blockly": "^13.4.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "meshoptimizer": "^1.3.0",
    "occt-import-js": "^0.0.23",
    "puppeteer-core": "^25.16.0",
    "vite": "^8.3.5"
  },
  "main": "electron/main.cjs",
  "description": "Deneyap Atölye - 3B Arduino/ESP32 ders uygulaması",
  "author": "Deneyap Atölye",
  "build": {
    "appId": "tr.deneyap.atolye",
    "productName": "Deneyap Atölye",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.cjs",
      "electron/icon.png",
      "dist/**",
      "package.json",
      "!node_modules/**"
    ],
    "icon": "electron/icon.png",
    "win": {
      "icon": "electron/icon.png",
      "forceCodeSigning": false,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
